// C89 backend: a checked tree in, one C89 translation unit out.
// Expects lang.check to have passed, and reads the types it left in tree.types;
// anything it still can't compile is reported as Unsupported.
package c89

import "base:runtime"
import "core:fmt"
import "core:strings"

import "../../lang"

// C keywords and the library names the generated code uses: a funC name that collides gets a `_`
C_RESERVED := [?]string {
	"auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else", "enum",
	"extern", "float", "for", "goto", "if", "int", "long", "register", "return", "short", "signed",
	"sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void", "volatile", "while",
	"fputs", "putchar", "printf", "puts", "stdout", "strcmp", "NULL", "EOF", "FILE", "main",
}

// funC ints are at least 32 bits; C89 only promises that for long
C_TYPES := [lang.Type]string {
	.Invalid = "int ",
	.None    = "void ",
	.Int     = "long ",
	.Bool    = "int ",
	.String  = "const char *",
}

C_OPERATORS := #partial [lang.Node_Kind]string {
	.Or = "||", .And = "&&", .Equal = "==", .NotEqual = "!=",
	.Less = "<", .LessEqual = "<=", .Greater = ">", .GreaterEqual = ">=",
	.Add = "+", .Subtract = "-", .Multiply = "*", .Divide = "/", .Remainder = "%",
}

Generator :: struct {
	tree:         ^lang.Tree,
	output:       strings.Builder,
	indentation:  int,
	declarations: []lang.Node_Id,
	diagnostics:  ^[dynamic]lang.Diagnostic,
	temporary:    runtime.Allocator, // scratch: expressions and pieces of lines, gone when generate returns
	in_main:      bool,
	uses_strcmp:  bool,
}

// the C source goes to `allocator`
generate :: proc(tree: ^lang.Tree, root: lang.Node_Id, diagnostics: ^[dynamic]lang.Diagnostic, allocator := context.allocator) -> string {
	scratch := lang.scratch_begin()
	defer lang.scratch_end(scratch)
	generator := Generator {
		tree         = tree,
		output       = strings.builder_make(scratch.allocator),
		declarations = lang.list_items(tree, tree.nodes[root].slots[0]),
		diagnostics  = diagnostics,
		temporary    = scratch.allocator,
	}
	g := &generator

	// C89 wants everything declared before use: prototypes, then variables, then bodies
	wrote_prototype := false
	for declaration in g.declarations {
		node := tree.nodes[declaration]
		if node.kind != .FunctionDeclaration || is_main(g, declaration) do continue
		if !wrote_prototype do write(g, "\n")
		write(g, "%s;\n", signature(g, declaration))
		wrote_prototype = true
	}
	wrote_variable := false
	for declaration in g.declarations {
		node := tree.nodes[declaration]
		#partial switch node.kind {
		case .VariableDeclaration:
			if !wrote_variable do write(g, "\n")
			// a file-scope initializer must be a constant: names are replaced by what they hold
			value, ok := constant(g, lang.Node_Id(node.slots[0]), 0, bare = true)
			if !ok do continue
			write(g, "static %s%s = %s;\n", C_TYPES[tree.types[declaration]], c_name(g, node.atom), value)
			wrote_variable = true
		case .Unparsed:
			unsupported(g, declaration, "this line didn't parse, fix it before compiling")
		}
	}
	for declaration in g.declarations {
		if tree.nodes[declaration].kind != .FunctionDeclaration do continue
		g.in_main = is_main(g, declaration)
		write(g, "\n%s\n", g.in_main ? "int main(void)" : signature(g, declaration))
		block(g, lang.Node_Id(tree.nodes[declaration].slots[1]))
	}

	// headers last: only now is it known what's used
	result := strings.builder_make(allocator)
	fmt.sbprintf(&result, "/* generated by funC from package %s */\n#include <stdio.h>\n", lang.atom_text(tree, tree.nodes[root].atom))
	if g.uses_strcmp do strings.write_string(&result, "#include <string.h>\n")
	strings.write_string(&result, strings.to_string(g.output))
	return strings.to_string(result)
}

write :: proc(g: ^Generator, format: string, args: ..any) {
	fmt.sbprintf(&g.output, format, ..args)
}

line :: proc(g: ^Generator, format: string, args: ..any) {
	for _ in 0 ..< g.indentation do strings.write_string(&g.output, "    ")
	fmt.sbprintf(&g.output, format, ..args)
	strings.write_byte(&g.output, '\n')
}

temporary :: proc(g: ^Generator, format: string, args: ..any) -> string {
	return fmt.aprintf(format, ..args, allocator = g.temporary)
}

unsupported :: proc(g: ^Generator, node: lang.Node_Id, detail: string) {
	nodes := g.tree.nodes
	append(g.diagnostics, lang.Diagnostic{code = .Unsupported, start = nodes[node].start, end = nodes[node].end, detail = detail})
}

is_main :: proc(g: ^Generator, declaration: lang.Node_Id) -> bool {
	node := g.tree.nodes[declaration]
	return node.kind == .FunctionDeclaration && lang.atom_text(g.tree, node.atom) == "main"
}

c_name :: proc(g: ^Generator, atom: lang.Atom) -> string {
	name := lang.atom_text(g.tree, atom)
	for reserved in C_RESERVED do if name == reserved do return strings.concatenate({name, "_"}, g.temporary)
	return name
}

// `static long fib(long n)`
signature :: proc(g: ^Generator, procedure: lang.Node_Id) -> string {
	tree := g.tree
	node := tree.nodes[procedure]
	parameters := lang.list_items(tree, node.slots[0])
	builder := strings.builder_make(g.temporary)
	fmt.sbprintf(&builder, "static %s%s(", C_TYPES[tree.types[procedure]], c_name(g, node.atom))
	if len(parameters) == 0 do strings.write_string(&builder, "void")
	for parameter, index in parameters {
		if index > 0 do strings.write_string(&builder, ", ")
		fmt.sbprintf(&builder, "%s%s", C_TYPES[tree.types[parameter]], c_name(g, tree.nodes[parameter].atom))
	}
	strings.write_byte(&builder, ')')
	return strings.to_string(builder)
}

// the file-scope variable a name refers to
find_variable :: proc(g: ^Generator, name: string) -> (lang.Node_Id, bool) {
	for declaration in g.declarations {
		node := g.tree.nodes[declaration]
		if node.kind == .VariableDeclaration && lang.atom_text(g.tree, node.atom) == name do return declaration, true
	}
	return 0, false
}

// an expression C89 accepts at file scope: literals and operators, with names replaced by their values
constant :: proc(g: ^Generator, expression: lang.Node_Id, depth: int, bare := false) -> (text: string, ok: bool) {
	tree := g.tree
	node := tree.nodes[expression]
	open, close := bare ? "" : "(", bare ? "" : ")"
	#partial switch node.kind {
	case .IntegerLiteral, .StringLiteral:
		return value(g, expression, true), true
	case .Identifier:
		name := lang.atom_text(tree, node.atom)
		if name == "true" || name == "false" do return value(g, expression, true), true
		if declaration, found := find_variable(g, name); found && depth < 64 {
			return constant(g, lang.Node_Id(tree.nodes[declaration].slots[0]), depth + 1, bare)
		}
	case .Negate, .Not:
		operand := constant(g, lang.Node_Id(node.slots[0]), depth) or_return
		return temporary(g, "%s%s%s%s", open, node.kind == .Negate ? "-" : "!", operand, close), true
	case:
		// strings compare with strcmp, which is a call: not a constant
		if node.kind in lang.BINARY && tree.types[node.slots[0]] != .String {
			left := constant(g, lang.Node_Id(node.slots[0]), depth) or_return
			right := constant(g, lang.Node_Id(node.slots[1]), depth) or_return
			return temporary(g, "%s%s %s %s%s", open, left, C_OPERATORS[node.kind], right, close), true
		}
	}
	unsupported(g, expression, "a file-scope variable must be worked out without calls: literals, operators and other variables")
	return "", false
}

block :: proc(g: ^Generator, block_node: lang.Node_Id) {
	line(g, "{{")
	g.indentation += 1
	opened := 0
	for statement in lang.list_items(g.tree, g.tree.nodes[block_node].slots[0]) {
		node := g.tree.nodes[statement]
		first, second := lang.Node_Id(node.slots[0]), lang.Node_Id(node.slots[1])
		#partial switch node.kind {
		case .VariableDeclaration:
			// C89 has no declarations after statements: each local variable opens its own scope
			line(g, "{{")
			g.indentation += 1
			opened += 1
			line(g, "%s%s = %s;", C_TYPES[g.tree.types[statement]], c_name(g, node.atom), value(g, first, true))
		case .Assignment:
			line(g, "%s = %s;", value(g, first, true), value(g, second, true))
		case .If:
			line(g, "if (%s)", value(g, first, true))
			block(g, second)
			if node.slots[2] != 0 {
				line(g, "else")
				block(g, lang.Node_Id(node.slots[2]))
			}
		case .While:
			line(g, "while (%s)", value(g, first, true))
			block(g, second)
		case .Return:
			// main is `int main(void)` in C: its bare return still says "success"
			if first != 0 do line(g, "return %s;", value(g, first, true))
			else do line(g, g.in_main ? "return 0;" : "return;")
		case .ExpressionStatement:
			expression_statement(g, first)
		case .Unparsed:
			unsupported(g, statement, "this line didn't parse, fix it before compiling")
		}
	}
	for _ in 0 ..< opened {
		g.indentation -= 1
		line(g, "}}")
	}
	if g.in_main && g.indentation == 1 do line(g, "return 0;")
	g.indentation -= 1
	line(g, "}}")
}

// An expression as C, every operation in parentheses so C's precedence never has to agree with ours.
// `bare` leaves off the outermost pair, where nothing surrounds it: `if (a < b)`, not `if ((a < b))`
value :: proc(g: ^Generator, expression: lang.Node_Id, bare := false) -> string {
	tree := g.tree
	node := tree.nodes[expression]
	open, close := bare ? "" : "(", bare ? "" : ")"
	#partial switch node.kind {
	case .StringLiteral:
		return temporary(g, "\"%s\"", lang.atom_text(tree, node.atom))
	case .IntegerLiteral:
		return temporary(g, "%sL", lang.atom_text(tree, node.atom))
	case .Identifier:
		name := lang.atom_text(tree, node.atom)
		if name == "true" do return "1"
		if name == "false" do return "0"
		return c_name(g, node.atom)
	case .Negate, .Not:
		return temporary(g, "%s%s%s%s", open, node.kind == .Negate ? "-" : "!", value(g, lang.Node_Id(node.slots[0])), close)
	case .FunctionCall:
		callee := tree.nodes[node.slots[0]]
		if callee.kind == .Identifier {
			arguments := lang.list_items(tree, node.slots[1])
			parts := make([dynamic]string, 0, len(arguments), g.temporary)
			for argument in arguments do append(&parts, value(g, argument, true))
			return temporary(g, "%s(%s)", c_name(g, callee.atom), strings.join(parts[:], ", ", g.temporary))
		}
	case:
		if node.kind in lang.BINARY {
			left := value(g, lang.Node_Id(node.slots[0]))
			right := value(g, lang.Node_Id(node.slots[1]))
			if tree.types[node.slots[0]] == .String {
				// == and != on strings compare what they say
				g.uses_strcmp = true
				return temporary(g, "%sstrcmp(%s, %s) %s 0%s", open, left, right, C_OPERATORS[node.kind], close)
			}
			return temporary(g, "%s%s %s %s%s", open, left, C_OPERATORS[node.kind], right, close)
		}
	}
	unsupported(g, expression, "the C89 backend can't compile this expression yet")
	return "0"
}

expression_statement :: proc(g: ^Generator, expression: lang.Node_Id) {
	tree := g.tree
	node := tree.nodes[expression]
	if node.kind != .FunctionCall {
		line(g, "(void)%s;", value(g, expression))
		return
	}
	callee := tree.nodes[node.slots[0]]
	if callee.kind == .Selector {
		// the checker made sure a selector call is fmt.print or fmt.println
		arguments := lang.list_items(tree, node.slots[1])
		parts := make([dynamic]string, 0, 2 * len(arguments) + 1, g.temporary)
		for argument, index in arguments {
			if index > 0 do append(&parts, "putchar(' ');")
			append(&parts, print_value(g, argument))
		}
		if lang.atom_text(tree, callee.atom) == "println" do append(&parts, "putchar('\\n');")
		if len(parts) > 0 do line(g, "%s", strings.join(parts[:], " ", g.temporary))
		return
	}
	line(g, "%s;", value(g, expression, true))
}

// a statement that prints one value, by its type
print_value :: proc(g: ^Generator, argument: lang.Node_Id) -> string {
	text := value(g, argument, true)
	#partial switch g.tree.types[argument] {
	case .Int:  return temporary(g, "printf(\"%%ld\", %s);", text)
	case .Bool: return temporary(g, "fputs((%s) ? \"true\" : \"false\", stdout);", text)
	}
	return temporary(g, "fputs(%s, stdout);", text)
}
