package c89

import "core:strings"
import "core:testing"

import "../../lang"

PROGRAM :: `package main
import "core:fmt"
greeting := "Hellope!"
alias := greeting
hello :: proc() {
    name := greeting
    fmt.println(name, "and \"quotes\"")
    int := "reserved in C"
    fmt.print(int)
    fmt.println()
}
main :: proc() {
    hello()
    fmt.println(alias)
}`

EXPECTED :: `/* generated by funC from package main */
#include <stdio.h>

static void hello(void);

static const char *greeting = "Hellope!";
static const char *alias = "Hellope!";

static void hello(void)
{
    {
        const char *name = greeting;
        fputs(name, stdout); putchar(' '); fputs("and \"quotes\"", stdout); putchar('\n');
        {
            const char *int_ = "reserved in C";
            fputs(int_, stdout);
            putchar('\n');
        }
    }
}

int main(void)
{
    hello();
    fputs(alias, stdout); putchar('\n');
    return 0;
}
`

@(test)
test_generate :: proc(t: ^testing.T) {
	tree: lang.Tree
	lang.tree_init(&tree)
	defer lang.tree_destroy(&tree)
	root, diagnostics := lang.parse(&tree, lang.find_syntax("odin"), PROGRAM)
	lang.check(&tree, root, &diagnostics)
	if !testing.expect_value(t, len(diagnostics), 0) do return

	before := lang.scratch_arena.total_used
	output := generate(&tree, root, &diagnostics, context.temp_allocator)
	testing.expect_value(t, len(diagnostics), 0)
	testing.expect_value(t, output, EXPECTED)
	testing.expect_value(t, lang.scratch_arena.total_used, before) // its temporaries are gone, the output isn't
}

@(test)
test_unparsed_is_unsupported :: proc(t: ^testing.T) {
	tree: lang.Tree
	lang.tree_init(&tree)
	defer lang.tree_destroy(&tree)
	root, diagnostics := lang.parse(&tree, lang.find_syntax("func"), `(file "main" (proc "main" (block (unparsed "oops"))))`)
	generate(&tree, root, &diagnostics, context.temp_allocator)
	if testing.expect_value(t, len(diagnostics), 1) {
		testing.expect_value(t, lang.diagnostic_message(diagnostics[0]), "this line didn't parse, fix it before compiling")
	}
}

LANGUAGE :: `package main
import "core:fmt"
limit := 15 + 1
fib :: proc(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}
main :: proc() {
    i := 1
    for i < limit && !(i == 3) {
        word := "x"
        if word != "y" {
            fmt.println(i, fib(i), i > 2)
        }
        i = i + 1
    }
    return
}`

@(test)
test_language :: proc(t: ^testing.T) {
	tree: lang.Tree
	lang.tree_init(&tree)
	defer lang.tree_destroy(&tree)
	root, diagnostics := lang.parse(&tree, lang.find_syntax("odin"), LANGUAGE)
	lang.check(&tree, root, &diagnostics)
	if !testing.expect_value(t, len(diagnostics), 0) do return

	output := generate(&tree, root, &diagnostics, context.temp_allocator)
	testing.expect_value(t, len(diagnostics), 0)
	fragments := []string {
		"#include <string.h>", // only because strings are compared
		"static long fib(long n);", // prototypes first
		"static long limit = 15L + 1L;", // a constant expression at file scope
		"return fib(n - 1L) + fib(n - 2L);",
		"while ((i < limit) && (!(i == 3L)))", // every operation in parentheses, none around the whole
		"if (strcmp(word, \"y\") != 0)",
		"printf(\"%ld\", i); putchar(' '); printf(\"%ld\", fib(i)); putchar(' '); fputs((i > 2L) ? \"true\" : \"false\", stdout); putchar('\\n');",
		"return 0;", // main's bare return
	}
	for fragment in fragments do testing.expectf(t, strings.contains(output, fragment), "missing %q in\n%s", fragment, output)
}

@(test)
test_file_scope_call_is_unsupported :: proc(t: ^testing.T) {
	tree: lang.Tree
	lang.tree_init(&tree)
	defer lang.tree_destroy(&tree)
	root, diagnostics := lang.parse(&tree, lang.find_syntax("odin"), "package main\nanswer :: proc() -> int {\n    return 42\n}\nx := answer()")
	lang.check(&tree, root, &diagnostics)
	if !testing.expect_value(t, len(diagnostics), 0) do return
	generate(&tree, root, &diagnostics, context.temp_allocator)
	if testing.expect_value(t, len(diagnostics), 1) {
		testing.expect(t, strings.contains(lang.diagnostic_message(diagnostics[0]), "without calls"))
	}
}
